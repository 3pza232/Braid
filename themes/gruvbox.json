{
  "id": "gruvbox",
  "name": "复古暖调",
  "version": "1.0.0",
  "colorScheme": "dark",
  "extends": "braid.dark",
  "description": "Gruvbox：暖黄与旧纸的复古配色，长时间阅读不刺眼",
  "tokens": {
    "semantic": {
      "bg": {
        "canvas": "#282828",
        "surface": "#32302F",
        "raised": "#3C3836",
        "sunken": "#1D2021",
        "overlay": "rgba(29, 32, 33, 0.82)"
      },
      "text": {
        "primary": "#EBDBB2",
        "secondary": "#D5C4A1",
        "tertiary": "#A89984",
        "disabled": "#7C6F64",
        "inverse": "#282828",
        "link": "#83A598"
      },
      "border": {
        "subtle": "#3C3836",
        "default": "#504945",
        "strong": "#665C54",
        "focus": "#FABD2F"
      },
      "accent": {
        "default": "#FABD2F",
        "hover": "#FFD75F",
        "active": "#D79921",
        "subtle": "rgba(250, 189, 47, 0.16)",
        "onAccent": "#282828"
      },
      "status": {
        "info": "#83A598",
        "success": "#B8BB26",
        "warning": "#FABD2F",
        "danger": "#FB4934",
        "onStatus": "#282828"
      },
      "role": {
        "userBubble": "#458588",
        "userText": "#FBF1C7",
        "assistantBubble": "#32302F",
        "assistantText": "#EBDBB2",
        "systemBubble": "#504945",
        "systemText": "#FABD2F",
        "toolBubble": "#32302F",
        "toolText": "#8EC07C"
      },
      "diff": {
        "add": "rgba(184, 187, 38, 0.16)",
        "addText": "#B8BB26",
        "del": "rgba(251, 73, 52, 0.16)",
        "delText": "#FB4934",
        "gutter": "#1D2021"
      },
      "selection": "rgba(250, 189, 47, 0.22)",
      "caret": "#FABD2F",
      "scrollbarThumb": "#504945",
      "scrollbarTrack": "transparent"
    }
  }
}
