{
  "name": "braid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Braid - 本地优先的 AI 对话工作台",
  "author": "PZA",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "npm run verify && vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "desktop:smoke": "electron . --smoke",
    "dist:win": "npm run build && electron-builder --win nsis",
    "typecheck": "tsc --noEmit",
    "check:layers": "node scripts/check-layers.mjs",
    "check:dead": "node scripts/check-dead.mjs",
    "check:styles": "node scripts/check-styles.mjs",
    "check:sql": "node --no-warnings scripts/check-sql.mjs",
    "check:docrefs": "node scripts/check-docrefs.mjs",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run check:layers && npm run check:styles && npm run check:dead && npm run check:sql && npm run check:docrefs && npm run test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "nanoid": "^6.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "wa-sqlite": "^1.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
